# Copy to .env to run with these values; .env is gitignored.
# All env vars are validated with zod at startup — invalid values fail fast.
# Canonical spec: specs/resource-server.md §2.
#
# These three vars are the entire identity-side configuration (BYOC contract,
# architecture §2.1). Swapping to a real IdP requires only changing them —
# no code changes.

# --- Identity (all required) ---

# Trusted issuer URL. Used to fetch JWKS and to validate token `iss`.
# Canonical form (architecture §4.11).
MCP_OIDC_ISSUER_URL=http://localhost:4444

# This server's canonical URI. Used both to validate token `aud` AND
# to populate the PRM `resource` field.
MCP_AUDIENCE=http://localhost:3333

# Comma-separated authorization server issuer URLs published in the
# PRM `authorization_servers` array. Each MUST canonicalize.
MCP_PRM_AUTH_SERVERS=http://localhost:4444

# --- Network ---

MCP_PORT=3333
