# Copy to .env to run with these values; .env is gitignored.
# All env vars are validated with zod at startup — invalid values fail fast.
# Canonical spec: specs/authorization-server.md §2.

# --- Identity (required) ---

# Issuer identifier. MUST canonicalize per architecture §4.11. For this PoC,
# MUST have an empty path component (no /tenantN suffix).
AS_ISSUER_URL=http://localhost:4444

# --- Network / storage ---

AS_PORT=4444
AS_DB_PATH=./as.db

# --- JWT signing ---

# RS256 | ES256 | EdDSA
AS_SIGNING_ALG=RS256

# Seconds
AS_TOKEN_TTL_SEC=300
AS_REFRESH_TOKEN_TTL_SEC=86400

# --- Demo / headless mode ---

# Skip login + consent UI; mint codes against AS_DEMO_USER_SUB. For CI demos.
AS_AUTO_APPROVE=false
AS_DEMO_USER_SUB=demo-user

# --- Dev-only ---

# Allow http://127.0.0.1[:port]/<path> CIMD URLs. Required for the local
# mcp-client (which serves its CIMD on loopback). MUST be false in production.
AS_DEV_ALLOW_INSECURE_CIMD=true
